{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "task-navigation",
  "description": "Allow the main window to restore and focus itself before task-detail navigation.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus"
  ]
}
