{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectPilot",
  "version": "1.1.0",
  "identifier": "com.projectpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProjectPilot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Racliu",
    "copyright": "Copyright © 2026 Racliu",
    "shortDescription": "ProjectPilot 本地项目管理",
    "longDescription": "ProjectPilot 是一款完全离线、使用本机 SQLite 存储的个人项目管理桌面应用。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
